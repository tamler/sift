{
  "name": "sift",
  "version": "0.1.0",
  "description": "Local RAG for Claude - semantic search over your documents via MCP",
  "type": "module",
  "main": "dist/mcp/server.js",
  "bin": {
    "sift": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/mcp/server.ts",
    "build": "tsc",
    "package": "npm run build && node scripts/package-extension.js",
    "test": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "rag",
    "claude",
    "mcp",
    "semantic-search",
    "local-ai",
    "embeddings",
    "ollama"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tamler/sift.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@electric-sql/pglite": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "mammoth": "^1.6.0",
    "pdfjs-dist": "^4.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
